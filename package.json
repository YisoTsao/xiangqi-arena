{
  "name": "xiangqi-arena",
  "private": true,
  "version": "0.1.0",
  "description": "Xiangqi Arena — 2.5D 線上象棋與暗棋競技場",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @xiangqi-arena/web --filter @xiangqi-arena/game-server dev",
    "dev:web": "pnpm --filter @xiangqi-arena/web dev",
    "dev:server": "pnpm --filter @xiangqi-arena/game-server dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "test:e2e": "pnpm --filter @xiangqi-arena/web test:e2e",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "typescript": "^5.9.3"
  }
}
